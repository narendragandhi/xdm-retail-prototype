{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/retail-customer.schema.json",
  "title": "Retail Customer Schema with Inheritance",
  "description": "XDM-style schema demonstrating inheritance patterns using allOf and definitions for Interactive Communications",
  "$defs": {
    "basePerson": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "title": "First Name",
          "minLength": 1,
          "maxLength": 50
        },
        "lastName": {
          "type": "string",
          "title": "Last Name",
          "minLength": 1,
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email Address"
        },
        "middleName": {
          "type": "string",
          "title": "Middle Name",
          "maxLength": 50
        },
        "suffix": {
          "type": "string",
          "title": "Name Suffix",
          "enum": ["Jr.", "Sr.", "II", "III", "IV", "V"]
        },
        "prefix": {
          "type": "string",
          "title": "Name Prefix",
          "enum": ["Mr.", "Ms.", "Mrs.", "Dr.", "Prof."]
        },
        "preferredName": {
          "type": "string",
          "title": "Preferred Display Name"
        }
      },
      "required": ["firstName", "lastName", "email"]
    },
    "contactInfo": {
      "type": "object",
      "properties": {
        "phoneNumbers": {
          "type": "array",
          "title": "Phone Numbers",
          "items": {
            "type": "object",
            "properties": {
              "number": { "type": "string", "title": "Phone Number" },
              "type": {
                "type": "string",
                "enum": ["mobile", "home", "work", "fax"]
              },
              "countryCode": {
                "type": "string",
                "title": "Country Code",
                "pattern": "^\\+[1-9]{1,3}$"
              },
              "primary": {
                "type": "boolean",
                "title": "Primary Phone",
                "default": false
              },
              "smsOptIn": {
                "type": "boolean",
                "title": "SMS Opt-In",
                "default": false
              },
              "whatsappOptIn": {
                "type": "boolean",
                "title": "WhatsApp Opt-In",
                "default": false
              }
            },
            "required": ["number", "type"]
          }
        },
        "preferredContactMethod": {
          "type": "string",
          "enum": ["email", "phone", "sms", "mail", "in-app"]
        },
        "bestTimeToContact": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "anytime"]
        },
        "doNotContact": {
          "type": "boolean",
          "title": "Do Not Contact Flag",
          "default": false
        },
        "doNotContactReason": {
          "type": "string",
          "title": "Do Not Contact Reason"
        }
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "street1": { "type": "string", "title": "Street Address" },
        "street2": { "type": "string", "title": "Street Address Line 2" },
        "city": { "type": "string", "title": "City" },
        "state": { "type": "string", "title": "State" },
        "postalCode": {
          "type": "string",
          "title": "Postal Code",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        },
        "country": { "type": "string", "title": "Country" },
        "addressType": {
          "type": "string",
          "enum": ["shipping", "billing", "home", "work", "seasonal"]
        },
        "primary": {
          "type": "boolean",
          "title": "Primary Address",
          "default": false
        },
        "validFrom": {
          "type": "string",
          "format": "date",
          "title": "Valid From Date"
        },
        "validationStatus": {
          "type": "string",
          "enum": ["verified", "unverified", "invalid"],
          "default": "unverified"
        }
      },
      "required": ["street1", "city", "state", "postalCode", "country"]
    },
    "loyaltyProgram": {
      "type": "object",
      "properties": {
        "loyaltyID": { "type": "string", "title": "Loyalty ID" },
        "tier": {
          "type": "string",
          "enum": ["bronze", "silver", "gold", "platinum", "diamond"]
        },
        "tierStatus": {
          "type": "string",
          "enum": ["active", "inactive", "suspended", "expired"],
          "default": "active"
        },
        "joinDate": { "type": "string", "format": "date" },
        "pointsBalance": { "type": "integer", "title": "Points Balance", "minimum": 0 },
        "pointsEarnedYTD": { "type": "integer", "title": "Points Earned YTD", "minimum": 0 },
        "pointsRedeemedYTD": { "type": "integer", "title": "Points Redeemed YTD", "minimum": 0 },
        "lifetimePoints": { "type": "integer", "title": "Lifetime Points", "minimum": 0 },
        "nextTierThreshold": { "type": "integer", "title": "Points to Next Tier", "minimum": 0 },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "free-shipping",
              "birthday-offer",
              "early-access",
              "gift-wrapping",
              "priority-support",
              "exclusive-events",
              "personal-stylist",
              "price-protection"
            ]
          }
        },
        "expirationDate": {
          "type": "string",
          "format": "date",
          "title": "Points Expiration Date"
        }
      },
      "required": ["loyaltyID", "tier"]
    },
    "demographics": {
      "type": "object",
      "properties": {
        "birthDate": { "type": "string", "format": "date", "title": "Date of Birth" },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "non-binary", "prefer-not-to-say"]
        },
        "maritalStatus": {
          "type": "string",
          "enum": ["single", "married", "divorced", "widowed"]
        },
        "householdSize": { "type": "integer", "minimum": 1, "maximum": 20 },
        "householdIncome": {
          "type": "string",
          "enum": ["under-25k", "25k-50k", "50k-75k", "75k-100k", "100k-150k", "over-150k"]
        },
        "educationLevel": {
          "type": "string",
          "enum": ["high-school", "some-college", "bachelors", "masters", "doctorate", "other"]
        },
        "occupation": { "type": "string", "title": "Occupation" },
        "industry": { "type": "string", "title": "Industry" }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "favoriteCategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priceSensitivity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "preferredChannel": {
          "type": "string",
          "enum": ["online", "mobile", "in-store", "phone"]
        },
        "shoppingFrequency": {
          "type": "string",
          "enum": ["weekly", "monthly", "quarterly", "occasionally"]
        },
        "brandPreferences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sizePreferences": {
          "type": "object",
          "properties": {
            "clothingSize": { "type": "string" },
            "shoeSize": { "type": "string" },
            "ringSize": { "type": "string" }
          }
        },
        "productInterests": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "marketingConsent": {
      "type": "object",
      "properties": {
        "emailConsent": { "type": "boolean", "title": "Email Consent" },
        "smsConsent": { "type": "boolean", "title": "SMS Consent" },
        "directMailConsent": { "type": "boolean", "title": "Direct Mail Consent" },
        "phoneConsent": { "type": "boolean", "title": "Phone Consent" },
        "thirdPartyConsent": { "type": "boolean", "title": "Third Party Marketing Consent" },
        "personalizedAdsConsent": { "type": "boolean", "title": "Personalized Ads Consent" },
        "dataSharingConsent": { "type": "boolean", "title": "Data Sharing Consent" },
        "consentDate": { "type": "string", "format": "date", "title": "Consent Date" },
        "consentSource": { "type": "string", "title": "Consent Source" },
        "consentVersion": { "type": "string", "title": "Privacy Policy Version" },
        "optOutAllMarketing": { "type": "boolean", "title": "Opt Out of All Marketing", "default": false }
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "accountID": {
          "type": "string",
          "title": "Account ID",
          "pattern": "^ACC-[0-9]{8}$"
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended", "closed", "pending-verification"],
          "default": "active"
        },
        "accountType": {
          "type": "string",
          "enum": ["personal", "business", "corporate", "premium", "guest"],
          "default": "personal"
        },
        "createdDate": { "type": "string", "format": "date", "title": "Account Created Date" },
        "lastActivityDate": { "type": "string", "format": "date", "title": "Last Activity Date" },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en-US", "en-GB", "fr-FR", "de-DE", "es-ES", "it-IT", "ja-JP", "zh-CN"],
          "default": "en-US"
        },
        "preferredCurrency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP", "CAD", "AUD", "JPY"],
          "default": "USD"
        },
        "timeZone": {
          "type": "string",
          "enum": ["America/New_York", "America/Los_Angeles", "America/Chicago", "Europe/London", "Europe/Paris", "Asia/Tokyo"],
          "default": "America/New_York"
        },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "transactionAlerts": { "type": "boolean", "default": true },
            "securityAlerts": { "type": "boolean", "default": true },
            "marketingAlerts": { "type": "boolean", "default": false },
            "pushNotifications": { "type": "boolean", "default": false },
            "alertFrequency": {
              "type": "string",
              "enum": ["instant", "daily-digest", "weekly-digest", "none"],
              "default": "instant"
            }
          }
        }
      },
      "required": ["accountID", "accountStatus"]
    },
    "transaction": {
      "type": "object",
      "properties": {
        "transactionID": {
          "type": "string",
          "title": "Transaction ID",
          "pattern": "^TXN-[0-9]{10}$"
        },
        "transactionDate": {
          "type": "string",
          "format": "date-time",
          "title": "Transaction Date"
        },
        "transactionType": {
          "type": "string",
          "enum": ["purchase", "return", "refund", "redemption", "earn", "adjustment"]
        },
        "amount": { "type": "number", "title": "Amount", "minimum": 0 },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP", "CAD", "AUD", "JPY"],
          "default": "USD"
        },
        "pointsEarned": { "type": "integer", "title": "Points Earned", "minimum": 0 },
        "pointsRedeemed": { "type": "integer", "title": "Points Redeemed", "minimum": 0 },
        "channel": {
          "type": "string",
          "enum": ["online", "mobile", "in-store", "phone", "kiosk"]
        },
        "orderNumber": { "type": "string", "title": "Order Number" },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "cancelled", "refunded"],
          "default": "completed"
        },
        "items": {
          "type": "array",
          "title": "Line Items",
          "items": {
            "type": "object",
            "properties": {
              "sku": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unitPrice": { "type": "number" },
              "category": { "type": "string" }
            },
            "required": ["sku", "name", "quantity"]
          }
        },
        "documentOfRecord": {
          "type": "boolean",
          "title": "Generate Document of Record",
          "default": true
        }
      },
      "required": ["transactionID", "transactionDate", "transactionType", "amount"]
    },
    "transactionSummary": {
      "type": "object",
      "properties": {
        "totalPurchases": { "type": "integer", "title": "Total Purchases", "minimum": 0 },
        "totalSpend": { "type": "number", "title": "Total Spend", "minimum": 0 },
        "averageOrderValue": { "type": "number", "title": "Average Order Value" },
        "totalPointsEarned": { "type": "integer", "title": "Total Points Earned", "minimum": 0 },
        "totalPointsRedeemed": { "type": "integer", "title": "Total Points Redeemed", "minimum": 0 },
        "favoriteCategory": { "type": "string", "title": "Favorite Category" },
        "lastPurchaseDate": { "type": "string", "format": "date", "title": "Last Purchase Date" },
        "preferredChannel": {
          "type": "string",
          "enum": ["online", "mobile", "in-store", "phone", "kiosk"]
        }
      }
    },
    "subscription": {
      "type": "object",
      "properties": {
        "subscriptionID": { "type": "string", "title": "Subscription ID" },
        "subscriptionType": {
          "type": "string",
          "enum": ["newsletter", "product-updates", "loyalty-rewards", "VIP-access"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "cancelled", "expired"],
          "default": "active"
        },
        "subscribedDate": { "type": "string", "format": "date", "title": "Subscribed Date" },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "quarterly", "on-demand"],
          "default": "weekly"
        },
        "format": {
          "type": "string",
          "enum": ["html", "text", "both"],
          "default": "both"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["new-arrivals", "sales", "electronics", "clothing", "home-garden", "beauty", "sports"]
          }
        },
        "doubleOptIn": { "type": "boolean", "title": "Double Opt-In", "default": false }
      },
      "required": ["subscriptionID", "subscriptionType", "status"]
    },
    "communicationPreferences": {
      "type": "object",
      "properties": {
        "languagePreference": {
          "type": "string",
          "enum": ["en-US", "en-GB", "fr-FR", "de-DE", "es-ES", "it-IT", "ja-JP", "zh-CN"],
          "default": "en-US"
        },
        "formatPreference": {
          "type": "string",
          "enum": ["html", "text", "accessible", "print-friendly"],
          "default": "html"
        },
        "deliveryChannel": {
          "type": "object",
          "properties": {
            "email": { "type": "boolean", "default": true },
            "sms": { "type": "boolean", "default": false },
            "push": { "type": "boolean", "default": false },
            "print": { "type": "boolean", "default": false },
            "inApp": { "type": "boolean", "default": true }
          }
        },
        "documentPreferences": {
          "type": "object",
          "properties": {
            "includeImages": { "type": "boolean", "default": true },
            "includePromotions": { "type": "boolean", "default": true },
            "includeLoyaltyInfo": { "type": "boolean", "default": true },
            "highContrastMode": { "type": "boolean", "default": false },
            "largeTextMode": { "type": "boolean", "default": false },
            "barcodeFormat": {
              "type": "string",
              "enum": ["CODE128", "QR", "EAN13", "UPC", "none"],
              "default": "CODE128"
            },
            "colorScheme": {
              "type": "string",
              "enum": ["standard", "grayscale", "high-contrast"],
              "default": "standard"
            }
          }
        },
        "statementPreferences": {
          "type": "object",
          "properties": {
            "statementType": {
              "type": "string",
              "enum": ["monthly", "quarterly", "annual", "on-demand"],
              "default": "monthly"
            },
            "includeMiniStatement": { "type": "boolean", "default": true },
            "includeTransactionGraph": { "type": "boolean", "default": true },
            "includePointsSummary": { "type": "boolean", "default": true },
            "includeOffersSection": { "type": "boolean", "default": true },
            "deliveryMethod": {
              "type": "string",
              "enum": ["electronic", "print-mail", "both"],
              "default": "electronic"
            }
          }
        },
        "interactiveCommunicationSettings": {
          "type": "object",
          "properties": {
            "templateVariant": {
              "type": "string",
              "enum": ["standard", "premium", "eco-friendly", "minimal"],
              "default": "standard"
            },
            "personalizationLevel": {
              "type": "string",
              "enum": ["none", "basic", "advanced", "full"],
              "default": "advanced"
            },
            "includeDynamicContent": { "type": "boolean", "default": true },
            "includeQRCode": { "type": "boolean", "default": true },
            "includeSurvey": { "type": "boolean", "default": false },
            "includeFeedback": { "type": "boolean", "default": false }
          }
        },
        "frequencyPreferences": {
          "type": "object",
          "properties": {
            "promotionalFrequency": {
              "type": "string",
              "enum": ["daily", "weekly", "monthly", "quarterly", "special-events-only"],
              "default": "weekly"
            },
            "transactionalFrequency": {
              "type": "string",
              "enum": ["immediate", "daily-digest", "weekly-digest", "none"],
              "default": "immediate"
            }
          }
        }
      },
      "required": ["languagePreference", "formatPreference"]
    },
    "interactionEvent": {
      "type": "object",
      "properties": {
        "interactionID": { "type": "string", "title": "Interaction ID" },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "title": "Interaction Timestamp"
        },
        "channel": {
          "type": "string",
          "enum": ["email", "sms", "push", "web", "mobile-app", "phone", "chat", "in-store", "social"]
        },
        "type": {
          "type": "string",
          "enum": ["open", "click", "purchase", "visit", "cart-add", "cart-abandon", "wishlist-add", "review-submit", "support-contact", "survey-complete", "referral", "share"]
        },
        "campaignID": { "type": "string", "title": "Campaign ID" },
        "campaignName": { "type": "string", "title": "Campaign Name" },
        "pageURL": { "type": "string", "title": "Page URL" },
        "productID": { "type": "string", "title": "Product ID" },
        "engagementScore": {
          "type": "number",
          "title": "Engagement Score",
          "minimum": 0,
          "maximum": 100
        },
        "duration": { "type": "integer", "title": "Duration in Seconds" }
      },
      "required": ["interactionID", "timestamp", "channel", "type"]
    },
    "engagementSummary": {
      "type": "object",
      "properties": {
        "totalInteractions": { "type": "integer", "title": "Total Interactions", "minimum": 0 },
        "emailOpenRate": { "type": "number", "title": "Email Open Rate", "minimum": 0, "maximum": 100 },
        "emailClickRate": { "type": "number", "title": "Email Click Rate", "minimum": 0, "maximum": 100 },
        "preferredChannel": {
          "type": "string",
          "enum": ["email", "sms", "push", "web", "mobile-app", "phone", "chat", "in-store"]
        },
        "lastEngagementDate": { "type": "string", "format": "date", "title": "Last Engagement Date" },
        "avgEngagementScore": {
          "type": "number",
          "title": "Average Engagement Score",
          "minimum": 0,
          "maximum": 100
        },
        "customerJourneyStage": {
          "type": "string",
          "enum": ["prospect", "new-customer", "active-customer", "loyal-customer", "at-risk", "churned"],
          "default": "prospect"
        },
        "npsScore": { "type": "integer", "title": "NPS Score", "minimum": 0, "maximum": 10 },
        "satisfactionScore": { "type": "number", "title": "Satisfaction Score", "minimum": 0, "maximum": 5 }
      }
    }
  },
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/basePerson" },
    { "$ref": "#/$defs/contactInfo" },
    {
      "properties": {
        "addresses": {
          "type": "array",
          "title": "Addresses",
          "items": { "$ref": "#/$defs/address" }
        }
      }
    },
    { "$ref": "#/$defs/loyaltyProgram" },
    { "$ref": "#/$defs/demographics" },
    { "$ref": "#/$defs/preferences" },
    { "$ref": "#/$defs/marketingConsent" },
    { "$ref": "#/$defs/account" },
    {
      "properties": {
        "transactionHistory": {
          "type": "array",
          "title": "Transaction History",
          "items": { "$ref": "#/$defs/transaction" }
        }
      }
    },
    {
      "properties": {
        "transactionSummary": { "$ref": "#/$defs/transactionSummary" }
      }
    },
    {
      "properties": {
        "subscriptions": {
          "type": "array",
          "title": "Subscriptions",
          "items": { "$ref": "#/$defs/subscription" }
        }
      }
    },
    { "$ref": "#/$defs/communicationPreferences" },
    {
      "properties": {
        "interactionHistory": {
          "type": "array",
          "title": "Interaction History",
          "items": { "$ref": "#/$defs/interactionEvent" }
        }
      }
    },
    {
      "properties": {
        "engagementMetrics": { "$ref": "#/$defs/engagementSummary" }
      }
    }
  ],
  "required": ["firstName", "lastName", "email"]
}
